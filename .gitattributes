# Auto detect text files and perform LF normalization
* text=auto

# The line above isn't enough on its own: with core.autocrlf=true these files
# are checked out with CRLF, and anything that builds from the working tree
# (`docker build`, `podman build`, `make` under WSL) then sees carriage returns.
# A shell script with CRLF fails with errors like
#   set: - : invalid option
# even though the deployed Space, built from a clean checkout, works fine.
#
# Titan ships no .sh inside the image today (the Dockerfile CMD is inline), so
# these entries are preventive.
*.sh            text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
*.template      text eol=lf

# Windows-only launchers stay CRLF, pinned so `* text=auto` cannot normalise
# them into something cmd.exe mis-parses.
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Never let git rewrite bytes inside binaries.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.woff          binary
*.woff2         binary
